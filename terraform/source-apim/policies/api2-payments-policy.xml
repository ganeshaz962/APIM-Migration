<policies>
    <inbound>
        <base />
        <set-backend-service backend-id="backend-payments-api" />
        <set-header name="Authorization" exists-action="override">
            <value>Bearer {{nv-api2-secret-header}}</value>
        </set-header>
        <rate-limit calls="100" renewal-period="60" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <set-header name="X-Payments-Gateway" exists-action="override">
            <value>Source-APIM</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
